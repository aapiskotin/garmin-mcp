# Never commit credentials. garmin-mcp-login reads them interactively by default.
GARMIN_EMAIL=
GARMIN_TOKEN_DIR=.garmin-tokens

# stdio is convenient for local MCP clients. Use streamable-http for a remote endpoint.
GARMIN_MCP_TRANSPORT=stdio
GARMIN_MCP_HOST=127.0.0.1
GARMIN_MCP_PORT=8765

# Keep data on a local disk; do not put WAL databases on network filesystems.
GARMIN_DATA_DIR=./.garmin-data
GARMIN_ACCOUNT_ID=personal
GARMIN_TIMEZONE=Europe/Berlin
GARMIN_OVERLAP_DAYS=7
GARMIN_BACKUP_ENABLED=true
GARMIN_BACKUP_TIME=03:00
